# Copy to .env and adjust. All vars are optional -- sane defaults run the
# whole sidecar standalone against the in-memory mock FABT + local SQLite.

# --- Mode switch ---
# true (default): run against the in-memory mock FABT, no real FABT/Twilio needed.
# false: talk to a real FABT deployment and send real SMS via Twilio.
BEDBOARD_USE_MOCK_FABT=true

# --- FABT upstream API (only used when BEDBOARD_USE_MOCK_FABT=false) ---
BEDBOARD_FABT_API_BASE_URL=http://localhost:8000
BEDBOARD_FABT_SERVICE_ACCOUNT_TOKEN=change-me

# --- Database (BedBoard's own sidecar tables only) ---
BEDBOARD_DATABASE_URL=sqlite+aiosqlite:///./bedboard.db
# Production (docker-compose default): postgresql+asyncpg://bedboard:bedboard@db:5432/bedboard

# --- Twilio (only used when BEDBOARD_USE_MOCK_FABT=false) ---
BEDBOARD_TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BEDBOARD_TWILIO_AUTH_TOKEN=change-me
BEDBOARD_TWILIO_FROM_NUMBER=+15550000000
BEDBOARD_TWILIO_VALIDATE_SIGNATURE=true

# --- Nudge scheduler ---
BEDBOARD_NUDGE_TIMEZONE=America/Los_Angeles
