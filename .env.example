# Copy to .env and adjust. All vars are optional -- sane defaults run the
# whole sidecar standalone against the in-memory mock FABT + local SQLite.

# --- Mode switch ---
# true (default): run against the in-memory mock FABT, no real FABT/Twilio needed.
# false: talk to a real FABT deployment and send real SMS via Twilio.
BEDBOARD_USE_MOCK_FABT=true

# --- FABT upstream API (only used when BEDBOARD_USE_MOCK_FABT=false) ---
BEDBOARD_FABT_API_BASE_URL=http://localhost:8080
# A COC_ADMIN-scoped API key, NOT a JWT: create one as a FABT admin via
#   POST /api/v1/api-keys   body: {"shelterId": null, "label": "BedBoard sidecar"}
# The plaintext key is returned exactly once at creation -- copy it here.
# Sent as the `X-API-Key` header, per FABT's ApiKeyAuthenticationFilter.
BEDBOARD_FABT_API_KEY=change-me
# Label only (never sent to FABT -- tenant scope is derived server-side
# from the API key itself). Used to tag ShelterSummary.tenant_id locally.
BEDBOARD_FABT_TENANT_ID=dev-coc

# --- Database (BedBoard's own sidecar tables only) ---
BEDBOARD_DATABASE_URL=sqlite+aiosqlite:///./bedboard.db
# Production (docker-compose default): postgresql+asyncpg://bedboard:bedboard@db:5432/bedboard

# Encrypts/hashes coordinator phone numbers at rest (app/crypto.py) --
# generate a real one with `openssl rand -base64 32`. Required (the app
# refuses to start without a real value) whenever BEDBOARD_USE_MOCK_FABT=false.
# Changing this after coordinators are already registered makes their
# existing phone_hash/phone_encrypted rows unreadable -- re-register them.
BEDBOARD_PHONE_ENCRYPTION_KEY=change-me

# --- Twilio (only used when BEDBOARD_USE_MOCK_FABT=false) ---
BEDBOARD_TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BEDBOARD_TWILIO_AUTH_TOKEN=change-me
BEDBOARD_TWILIO_FROM_NUMBER=+15550000000
BEDBOARD_TWILIO_VALIDATE_SIGNATURE=true

# --- Nudge scheduler ---
BEDBOARD_NUDGE_TIMEZONE=America/Los_Angeles
